% Reviewer comments are blue and author responses are red by default.
% Labels also distinguish the two kinds of text in monochrome.
\newif\ifresponsecolors
\responsecolorstrue
% Change the preceding line to \responsecolorsfalse to use monochrome.
\definecolor{commentblue}{RGB}{25,76,140}
\definecolor{responsered}{RGB}{150,32,42}
\setlength{\emergencystretch}{3em}

\newenvironment{reviewercomment}
  {\begin{quote}\ifresponsecolors\color{commentblue}\fi
   \noindent\textbf{Reviewer comment.}\ }
  {\end{quote}}

\newenvironment{authorresponse}
  {\begin{quote}\ifresponsecolors\color{responsered}\fi
   \noindent\textbf{Response.}\ }
  {\end{quote}}

\newcommand{\revisionlocation}[1]{\par\smallskip\noindent
  \textbf{Location in the revised submission.}\ #1}
\newcommand{\manuscriptid}{{{MANUSCRIPT_ID}}}

